# Token của bot lấy từ @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID của tài khoản Telegram của bạn (lấy từ @userinfobot)
ADMIN_CHAT_ID=

# Token tài khoản 79AI / Gommo (nếu cần chạy độc lập ngoài electron app)
GOMMO_TOKEN=

# Số luồng render đồng thời (khuyên dùng 5 - 10)
CONCURRENCY=8

# Timeout cho mỗi video (giây) - mặc định 900s = 15 phút
TIMEOUT_SECONDS=900
